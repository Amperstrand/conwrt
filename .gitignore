# OpenWrt build trees and image builders (multi-GB)
openwrt-minimal/
openwrt-imagebuilder-*/

# Binary firmware images
*.bin
images/

# Screenshots
*.png

# Build output / dist artifacts
dist/
runs/

# Local test results — never published, may contain network details
test-results/
tests/integration/.serial.log
tests/integration/.vm_ssh_key
tests/integration/.vm_ssh_key.pub
tests/integration/.openwrt-base.qcow2
tests/integration/.openwrt-session.qcow2

# OpenCode / Playwright internal
.omo/
.playwright-mcp/
.sisyphus/
.cursor/

# Local-only operational artifacts — never publish (operator rule 2026-09-22)
# Session records, inventory, backups, captures, running rig configs.
data/*
!data/.gitkeep
captures/*
!captures/.gitkeep
backups/
config.toml
labgrid/exporter.yaml
serial/
conwrt.egg-info/
__pycache__/

# OS junk
.DS_Store
*~
*.swp
*.swo
.coverage
tests/integration/.openwrt-flash-session.qcow2
tests/integration/.openwrt-flash-vm.pid
tests/integration/.openwrt-flash-serial.log
tests/integration/.flash-test-config.toml
tests/integration/.venv-cashu/
tests/integration/.tollgate/
tests/integration/.openwrt.img
tests/integration/.openwrt-flash-session.qcow2
tests/integration/.venv-cashu/

# Vendor firmware blobs — too big / licensing-unclear for git (keep local)
firmware/
# Runtime artifacts misplaced under scripts/ (tool path bug — top-level dirs are canonical)
scripts/captures/
scripts/data/
# Real labgrid console config carries live credentials (header rule: local-only)
labgrid/console.yaml

# local operator-profile backup (same rule as config.toml)
config.toml.bak
